{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "cd apps/consumer && npm ci",
  "buildCommand": "cd apps/consumer && npm run build",
  "outputDirectory": "apps/consumer/.next",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD apps/consumer || exit 1"
}
